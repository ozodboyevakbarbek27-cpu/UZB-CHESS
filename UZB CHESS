<script>

/* =====================================
   UMUMIY
===================================== */

let selectedTime = 600;
let isCustom = false;
let setupMode = "local";


function showPage(id){

document
.querySelectorAll(".page")
.forEach(x=>x.classList.remove("active"));

document
.getElementById(id)
.classList.add("active");

window.scrollTo(0,0);

}


function openSetup(mode){

setupMode = mode;

document
.getElementById("setupTitle")
.textContent =
mode === "online"
? "🌐 Online o‘yin"
: "⚙️ Local o‘yin";

document
.getElementById("setupHint")
.textContent =
mode === "online"
? "Vaqtni tanlang va keyin xona yarating."
: "Ikki kishi bitta telefonda o‘ynaydi.";

showPage("setup");

}


/* =====================================
   VAQT
===================================== */

function selectTime(sec,btn){

selectedTime = sec;
isCustom = false;

document
.querySelectorAll(".time")
.forEach(x=>x.classList.remove("selected"));

btn.classList.add("selected");

document.getElementById("custom").style.display="none";

}


function customTime(btn){

isCustom=true;

document
.querySelectorAll(".time")
.forEach(x=>x.classList.remove("selected"));

btn.classList.add("selected");

document.getElementById("custom").style.display="block";

}


function getTime(){

if(!isCustom)
return selectedTime;

let m =
parseInt(
document.getElementById("customMinutes").value
);

if(!m || m<1 || m>180){

alert("1 dan 180 gacha daqiqa kiriting.");

return null;

}

return m*60;

}


function continueSetup(){

let t=getTime();

if(t===null)
return;

selectedTime=t;

if(setupMode==="local")
startLocal();

else
showPage("onlineLobby");

}


/* =====================================
   CHESS
===================================== */

let chess = new Chess();

let gameMode="local";

let boardFlipped=false;

let selectedSquare=null;

let gameActive=false;

let whiteTime=0;

let blackTime=0;

let timer=null;

let myColor=null;

let peer=null;

let conn=null;

let roomId=null;

let isHost=false;


const symbols={

w:{
p:"♙",
n:"♘",
b:"♗",
r:"♖",
q:"♕",
k:"♔"
},

b:{
p:"♟",
n:"♞",
b:"♝",
r:"♜",
q:"♛",
k:"♚"
}

};


/* =====================================
   LOCAL
===================================== */

function startLocal(){

cleanupOnline();

gameMode="local";

chess=new Chess();

boardFlipped=false;

selectedSquare=null;

whiteTime=selectedTime;

blackTime=selectedTime;

gameActive=true;

document.getElementById("modeLabel").textContent="● LOCAL";

document.getElementById("modeLabel").className="local";

showPage("game");

renderBoard();

updateUI();

updateMoves();

startTimer();

}


/* =====================================
   TAHTA
===================================== */

function renderBoard(){

const el=document.getElementById("board");

el.innerHTML="";

const b=chess.board();

for(let dr=0;dr<8;dr++){

for(let dc=0;dc<8;dc++){

let r=boardFlipped ? 7-dr : dr;

let c=boardFlipped ? 7-dc : dc;

const sq=document.createElement("div");

sq.className =
((r+c)%2===0
?"square light"
:"square dark");


const name =
String.fromCharCode(97+c)+(8-r);


if(selectedSquare===name)
sq.classList.add("selected");


if(selectedSquare){

const moves =
chess.moves({
square:selectedSquare,
verbose:true
});

const m =
moves.find(x=>x.to===name);

if(m)
sq.classList.add(
m.captured
?"capture"
:"possible"
);

}


const piece=b[r][c];


if(piece){

const p=document.createElement("span");

p.className =
"piece "+
(piece.color==="w"
?"wp"
:"bp");

p.textContent =
symbols[piece.color][piece.type];

sq.appendChild(p);

}


if(dr===0){

const rank=document.createElement("span");

rank.className="coord rank";

rank.textContent=8-r;

sq.appendChild(rank);

}


if(dr===7){

const file=document.createElement("span");

file.className="coord file";

file.textContent=
String.fromCharCode(97+c);

sq.appendChild(file);

}


if(
piece &&
piece.type==="k" &&
chess.in_check() &&
piece.color===chess.turn()
){

sq.classList.add("incheck");

}


sq.onclick=()=>clickSquare(name);

el.appendChild(sq);

}

}

}


/* =====================================
   KATAK
===================================== */

function clickSquare(name){

if(!gameActive)
return;

const turn=chess.turn();


if(
gameMode==="online" &&
myColor!==turn
)
return;


const piece=chess.get(name);


if(selectedSquare){

const moves =
chess.moves({
square:selectedSquare,
verbose:true
});

const move =
moves.find(x=>x.to===name);


if(move){

doMove(selectedSquare,name);

return;

}


if(
piece &&
piece.color===turn
){

selectedSquare=name;

renderBoard();

return;

}


selectedSquare=null;

renderBoard();

return;

}


if(
piece &&
piece.color===turn
){

selectedSquare=name;

renderBoard();

}

}


/* =====================================
   YURISH
===================================== */

function doMove(from,to){

const move =
chess.move({
from:from,
to:to,
promotion:"q"
});

if(!move)
return;

selectedSquare=null;

renderBoard();

updateUI();

updateMoves();

checkGameEnd();


if(gameMode==="online")
sendState();

}


/* =====================================
   UNDO
===================================== */

function undoLocal(){

if(gameMode==="online"){

alert(
"Online o‘yinda Orqaga funksiyasi o‘chirilgan."
);

return;

}

chess.undo();

renderBoard();

updateUI();

updateMoves();

}


/* =====================================
   YANGI
===================================== */

function newGame(){

if(gameMode==="online"){

if(!isHost){

alert(
"Online yangi o‘yinni xona egasi boshlaydi."
);

return;

}

chess=new Chess();

whiteTime=selectedTime;

blackTime=selectedTime;

gameActive=true;

renderBoard();

updateUI();

updateMoves();

sendState();

return;

}

startLocal();

}


/* =====================================
   TAHTANI AYLANTRISH
===================================== */

function flipBoard(){

boardFlipped=!boardFlipped;

renderBoard();

}


/* =====================================
   MENYU
===================================== */

function leaveGame(){

gameActive=false;

clearInterval(timer);

cleanupOnline();

showPage("home");

}


/* =====================================
   TIMER
===================================== */

function startTimer(){

clearInterval(timer);

if(selectedTime===0){

updateClocks();

return;

}


timer=setInterval(()=>{

if(!gameActive)
return;


if(chess.turn()==="w")
whiteTime--;

else
blackTime--;


if(whiteTime<=0){

whiteTime=0;

gameActive=false;

clearInterval(timer);

document.getElementById("status")
.textContent=
"⏱️ Oq vaqti tugadi — Qora g‘alaba!";

}


if(blackTime<=0){

blackTime=0;

gameActive=false;

clearInterval(timer);

document.getElementById("status")
.textContent=
"⏱️ Qora vaqti tugadi — Oq g‘alaba!";

}


if(gameMode==="online")
sendClock();


updateClocks();

},1000);

}


function updateClocks(){

document.getElementById("whiteClock")
.textContent =
selectedTime===0
?"∞"
:formatTime(whiteTime);


document.getElementById("blackClock")
.textContent =
selectedTime===0
?"∞"
:formatTime(blackTime);

}


function formatTime(s){

let m=Math.floor(Math.max(0,s)/60);

let x=Math.max(0,s)%60;

return m+":"+(x<10?"0":"")+x;

}


/* =====================================
   UI
===================================== */

function updateUI(){

document
.getElementById("whitePlayer")
.classList.toggle(
"active",
chess.turn()==="w"
);

document
.getElementById("blackPlayer")
.classList.toggle(
"active",
chess.turn()==="b"
);


let status;


if(chess.in_check()){

status =
chess.turn()==="w"
?"⚠️ Oqga SHOH!"
:"⚠️ Qoraga SHOH!";

}else{

status =
chess.turn()==="w"
?"⚪ Oq yuradi"
:"⚫ Qora yuradi";

}


if(
gameMode==="online" &&
myColor
){

status +=
myColor===chess.turn()
?" • Sizning navbatingiz"
:" • Raqib navbati";

}


document.getElementById("status")
.textContent=status;

updateClocks();

}


function updateMoves(){

const el=document.getElementById("moveList");

el.innerHTML="";

const h=chess.history();

for(let i=0;i<h.length;i+=2){

const d=document.createElement("div");

d.className="move";

d.innerHTML=
"<b>"+(Math.floor(i/2)+1)+".</b> "+
(h[i]||"")+" "+
(h[i+1]||"");

el.appendChild(d);

}

el.scrollTop=el.scrollHeight;

}


/* =====================================
   O‘YIN TUGASHI
===================================== */

function checkGameEnd(){

if(!chess.game_over())
return;

gameActive=false;

clearInterval(timer);


if(chess.in_check()){

const winner =
chess.turn()==="w"
?"⚫ Qora"
:"⚪ Oq";

document.getElementById("status")
.textContent=
"👑 SHOH-MAT! "+
winner+
" g‘alaba qildi!";

}else{

document.getElementById("status")
.textContent=
"🤝 Durang!";

}

}


/* =====================================
   ONLINE ROOM
===================================== */

function randomRoom(){

return Math
.random()
.toString(36)
.substring(2,8)
.toUpperCase();

}


function createRoom(){

cleanupOnline();

gameMode="online";

isHost=true;

myColor="w";

roomId=randomRoom();

document.getElementById("roomCode")
.textContent=roomId;

document.getElementById("roomStatus")
.textContent=
"⏳ Do‘st kutilmoqda...";


showPage("room");


peer =
new Peer("chess-arena-"+roomId);


peer.on("connection",(c)=>{

conn=c;


conn.on("open",()=>{

document.getElementById("roomStatus")
.textContent=
"🟢 Do‘st qo‘shildi!";

startOnlineGame();

});


conn.on("data",handleData);


conn.on("close",()=>{

gameActive=false;

alert("Raqib o‘yindan chiqdi.");

});

});


peer.on("error",()=>{

document.getElementById("roomStatus")
.textContent=
"❌ Xona ulanishida xatolik.";

});

}


/* =====================================
   ONLINE JOIN
===================================== */

function joinRoom(){

const code =
(
document.getElementById("joinCode")
.value||""
)
.trim()
.toUpperCase();


if(code.length!==6){

alert("6 xonali kod kiriting.");

return;

}


cleanupOnline();

gameMode="online";

isHost=false;

myColor="b";

roomId=code;


document.getElementById("onlineMsg")
.textContent=
"⏳ Ulanmoqda...";


peer=new Peer();


peer.on("open",()=>{

conn =
peer.connect(
"chess-arena-"+code,
{
reliable:true
}
);


conn.on("open",()=>{

document.getElementById("onlineMsg")
.textContent=
"🟢 Ulandi!";

conn.send({

type:"join",

time:selectedTime

});

});


conn.on("data",handleData);


conn.on("close",()=>{

gameActive=false;

alert("Raqib o‘yindan chiqdi.");

});

});


peer.on("error",()=>{

document.getElementById("onlineMsg")
.textContent=
"❌ Xona topilmadi yoki ulanishda xatolik.";

});

}


/* =====================================
   ONLINE GAME
===================================== */

function startOnlineGame(){

chess=new Chess();

boardFlipped=false;

selectedSquare=null;

whiteTime=selectedTime;

blackTime=selectedTime;

gameActive=true;


document.getElementById("modeLabel")
.textContent="● ONLINE";

document.getElementById("modeLabel")
.className="online";


showPage("game");

renderBoard();

updateUI();

updateMoves();

startTimer();


if(isHost)
sendState();

}


/* =====================================
   SEND STATE
===================================== */

function sendState(){

if(!conn || conn.open!==true)
return;


conn.send({

type:"state",

fen:chess.fen(),

whiteTime:whiteTime,

blackTime:blackTime,

time:selectedTime,

active:gameActive

});

}


function sendClock(){

if(!conn || conn.open!==true)
return;


conn.send({

type:"clock",

whiteTime:whiteTime,

blackTime:blackTime,

active:gameActive

});

}


/* =====================================
   RECEIVE
===================================== */

function handleData(data){

if(!data)
return;


if(
data.type==="join" &&
isHost
){

selectedTime =
data.time ||
selectedTime;

whiteTime=selectedTime;

blackTime=selectedTime;

startOnlineGame();

sendState();

return;

}


if(
data.type==="state" &&
!isHost
){

chess.load(data.fen);

selectedTime =
data.time ||
selectedTime;

whiteTime=data.whiteTime;

blackTime=data.blackTime;

gameActive=data.active;

showPage("game");

renderBoard();

updateUI();

updateMoves();

startTimer();

checkGameEnd();

return;

}


if(data.type==="clock"){

whiteTime=data.whiteTime;

blackTime=data.blackTime;

gameActive=data.active;

updateClocks();

}

}


/* =====================================
   COPY ROOM
===================================== */

function copyRoom(){

const code =
document.getElementById("roomCode")
.textContent;


if(
navigator.clipboard &&
navigator.clipboard.writeText
){

navigator.clipboard
.writeText(code)
.then(()=>{

document.getElementById("roomStatus")
.textContent=
"📋 Kod nusxalandi!";

});

}else{

alert("Xona kodi: "+code);

}

}


/* =====================================
   CLEANUP
===================================== */

function cleanupOnline(){

clearInterval(timer);


try{

if(conn)
conn.close();

}catch(e){}


try{

if(peer)
peer.destroy();

}catch(e){}


conn=null;

peer=null;

roomId=null;

isHost=false;

myColor=null;

}

</script>

