<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">

<title>UZB CHESS</title>

<script src="https://cdnjs.cloudflare.com/ajax/libs/chess.js/0.10.3/chess.min.js"></script>
<script src="https://unpkg.com/peerjs@1.5.4/dist/peerjs.min.js"></script>

<style>
*{
  box-sizing:border-box;
  -webkit-tap-highlight-color:transparent;
}

body{
  margin:0;
  background:#080a0e;
  color:white;
  font-family:Arial,sans-serif;
}

.app{
  max-width:720px;
  margin:auto;
  min-height:100vh;
  padding-bottom:30px;
}

header{
  text-align:center;
  padding:22px 10px;
  background:#11151b;
  border-bottom:1px solid #292f38;
}

.logo{
  font-size:32px;
  font-weight:900;
}

.logo span{
  color:#e5b342;
}

.sub{
  margin-top:6px;
  color:#858d98;
}

.page{
  display:none;
  padding:14px;
}

.page.active{
  display:block;
}

.card{
  background:#151a20;
  border:1px solid #2b323c;
  border-radius:20px;
  padding:18px;
  margin-bottom:14px;
}

.menu{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:12px;
}

button{
  border:1px solid #303741;
  background:#171d24;
  color:white;
  border-radius:15px;
  padding:15px;
  font-size:16px;
  cursor:pointer;
}

button:active{
  transform:scale(.97);
}

.menu button{
  min-height:115px;
}

.menu button:first-child{
  border-color:#e5b342;
}

.icon{
  font-size:32px;
  display:block;
  margin-bottom:8px;
}

.back{
  margin-bottom:12px;
}

.timegrid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}

.time.selected{
  border-color:#e5b342;
  color:#e5b342;
  background:#30240c;
}

.primary{
  width:100%;
  margin-top:15px;
  background:#e5b342;
  color:#111;
  font-weight:bold;
}

input{
  width:100%;
  margin-top:10px;
  padding:15px;
  border-radius:12px;
  border:1px solid #303741;
  background:#0d1116;
  color:white;
  font-size:16px;
}

.players{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:9px;
}

.player{
  background:#151a20;
  border:1px solid #2b323c;
  border-radius:16px;
  padding:12px;
}

.player.active{
  border-color:#e5b342;
  box-shadow:0 0 18px #e5b34222;
}

.pname{
  color:#aeb4bd;
}

.clock{
  color:#e5b342;
  font-size:28px;
  font-weight:bold;
  margin-top:4px;
}

.status{
  text-align:center;
  min-height:42px;
  padding:10px 0;
  color:#e5b342;
  font-weight:bold;
  font-size:19px;
}

/* SHAXMAT TAXTASI */

#board{
  width:100%;
  aspect-ratio:1;
  display:grid;
  grid-template-columns:repeat(8,1fr);
  border:6px solid #252b32;
  border-radius:7px;
  overflow:hidden;
}

.square{
  position:relative;
  display:flex;
  align-items:center;
  justify-content:center;
  aspect-ratio:1;
}

.light{
  background:#ead5a4;
}

.dark{
  background:#765a3a;
}

.piece{
  font-size:clamp(39px,11vw,78px);
  line-height:1;
  user-select:none;
  z-index:2;
  filter:drop-shadow(0 4px 3px #0008);
}

.wp{
  color:white;
  text-shadow:0 2px 3px #555;
}

.bp{
  color:#111;
  text-shadow:0 2px 2px #fff5;
}

.selected{
  box-shadow:inset 0 0 0 5px #e5b342;
}

.possible:after{
  content:"";
  width:20%;
  height:20%;
  border-radius:50%;
  background:#e5b342;
  position:absolute;
}

.capture:after{
  content:"";
  position:absolute;
  inset:5px;
  border:4px solid #e5b342;
  border-radius:50%;
}

.incheck{
  box-shadow:
    inset 0 0 0 5px #e34d4d,
    inset 0 0 30px #e34d4d55;
}

.coord{
  position:absolute;
  font-size:10px;
  font-weight:bold;
  opacity:.65;
  z-index:3;
}

.rank{
  left:3px;
  top:2px;
}

.file{
  right:3px;
  bottom:2px;
}

.controls{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:7px;
  margin-top:10px;
}

.controls button{
  padding:13px 3px;
  font-size:12px;
}

.moves{
  margin-top:12px;
  padding:13px;
  background:#11161c;
  border:1px solid #292f38;
  border-radius:15px;
  max-height:180px;
  overflow:auto;
}

.move{
  padding:5px 0;
  border-bottom:1px solid #20262d;
  color:#b0b6bf;
}

.room{
  text-align:center;
  color:#e5b342;
  font-size:32px;
  font-weight:bold;
  letter-spacing:5px;
  padding:15px;
}

.center{
  text-align:center;
}

.small{
  color:#9299a3;
  line-height:1.5;
}

.online{
  color:#63d28d;
}

.local{
  color:#63d28d;
}

@media(max-width:400px){
  .piece{
    font-size:34px;
  }

  .controls button{
    font-size:10px;
  }
}
</style>
</head>

